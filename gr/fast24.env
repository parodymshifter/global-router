# fast24.env -- the ISPD 2024 pipeline chosen in HISTORY_COST_SWEEP.md Part
# 115, layered on @standard.env @standard24.env: the pattern stage and the
# slow tier (stops at 2D overflow <= 300), layer assignment's first round,
# and the 3D pattern passes. Dropped: the region stage, refinement and the
# reclaim fallback (no score change on 11 designs; 25 min on
# mempool_cluster_ranking for its last 11 units of 2D overflow), the tree
# rebuild and wirelength recovery (made the 2024 score worse), and layer
# assignment's negotiation rounds (+-0.01% for 2-3x the time).
PD5ROUTE_REGION=0
PD4ROUTE_REFINE=0
PD19ROUTE_RECLAIM_FALLBACK=0
PD8ROUTE_REBUILD=0
PD7ROUTE_WL=0
NV2ROUTE_VIA_ROUNDS=0
# Part 118: the slow tier batched against snapshots, 64 nets a batch
# (pd38route; older routers ignore it). A better score on all 13 designs,
# the same at every thread count; the slow tier 1.5-1.8x faster on the
# cluster designs at 8 threads. Threads stay per run (PD37ROUTE_THREADS).
PD38ROUTE_SLOW_BATCH=64
