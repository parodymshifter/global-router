# standard24.env -- the ISPD 2024 additions to the standard configuration
# (HISTORY_COST_SWEEP.md Parts 103-107). Use after standard.env, with pd35route
# or later on a .cap design:
#   <name> bench/ispd24/<design>.cap ./pd35route @standard.env @standard24.env
# Via demand charged in layer assignment, and layer assignment priced in the
# 2024 score's own terms (marginal exponential overflow cost + unitVia).
PD33ROUTE_VIA_DEMAND=1
PD33ROUTE_LA_COST=score
# Part 105: each pin's access point by InstantGR's alignment rule.
PD33ROUTE_AP=align
# Part 107: the joint 3D pattern reroute after layer assignment (pd35route
# or later; earlier routers ignore it).
PD35ROUTE_PATTERN3D=3
