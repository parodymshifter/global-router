# fast08.env -- the ISPD 2024 runtime mechanisms (Parts 116-120) applied to
# the ISPD 2008 standard, layered on @standard.env (HISTORY_COST_SWEEP.md
# Part 124). A candidate, not the standard, until Part 124's runs judge it.
# Use: <name> bench/<design>.gr ./pd39route @standard.env @fast08.env
#
# Exact (the same routes at any thread count, Parts 116 and 120): worker
# threads, and the pattern stage's batches on the dependency graph. On the
# 2008 designs the pattern stage is ~0.2% of the run, so these buy little.
PD37ROUTE_THREADS=8
PD38ROUTE_PATTERN_DAG=1
# Not exact (Parts 118-119; judged on overflow and wirelength here): the
# slow tier in batches of 256 drawn round-robin from 64 x 64-tile areas,
# searched in parallel against snapshots and committed in net order. The
# slow tier is ~28% of a 2008 run (newblue4: 2691 of 9504 s).
PD38ROUTE_SLOW_BATCH=256
PD38ROUTE_SLOW_SPREAD=64
# Not applied: the region stage, refinement and the reclaim fallback stay
# on (2008 needs them to reach zero overflow; the 2024 pipeline dropped
# them, so nothing threads them yet -- ~70% of a 2008 run). The 3D pattern
# passes (PD38ROUTE_P3D_REUSE) are a 2024-only stage.
