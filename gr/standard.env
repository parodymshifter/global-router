# standard.env -- the standard configuration for gr/pd21route (2026-10-03;
# gr/pd14route before that -- every setting below up to the Part 80 block
# means the same on pd14route, which ignores the rest).
# One setting for every ISPD 2008 benchmark, no per-benchmark tuning.
# Use: ./run_batch.sh job lines take "@standard.env" in place of the
# VAR=value list (more VAR=value pairs after it override), e.g.
#   std_adaptec1 bench/adaptec1.capo70.3d.35.50.90.gr ./pd21route @standard.env
# or in a shell:  env $(grep -v '^#' standard.env | xargs) ./pd21route in.gr out.route
#
# Where each line was decided: HISTORY_COST_SWEEP.md Part 71 (the base
# pipeline), Part 72 (pd11route's pattern stage, on by default), Part 74
# (floor-gated plateau stop), Part 76 (margin caps), Part 80 (work-gated
# plateau stop), Parts 83-88 (detour reclaim with a fallback). Remove
# VROUTE_TRACE for quiet runs.
VROUTE_TRACE=1
# Base pipeline (Part 71): fast/slow/via round budgets, slow-tier boxes,
# present-demand pricing with every reroute kept, piece rip-up, hotspot
# region stage, refinement, slow-tier pieces with the 300 stop.
VROUTE_FAST_ROUNDS=60
VROUTE_SLOW_ROUNDS=150
NV2ROUTE_VIA_ROUNDS=200
NV11ROUTE_BOX_MODE=round
NV11ROUTE_BOX_INIT=48
NV11ROUTE_BOX_GROW=2
NV11ROUTE_BOX_CAP=200
PD1ROUTE_COST=pd
PD2ROUTE_ACCEPT=keep
PD6ROUTE_PIECES=1
PD5ROUTE_REGION=1
PD5ROUTE_REGION_ROUNDS=500
PD4ROUTE_REFINE_ACCEPT=revert
PD4ROUTE_REFINE_ITERS=60
PD4ROUTE_REFINE_BOX_INC=5
PD9ROUTE_SLOW_PIECES=1
PD9ROUTE_STOP_AT=300
# Floor-gated plateau stop (Part 74): only residues >= 1000 (newblue3).
PD12ROUTE_REGION_PLATEAU=50
PD12ROUTE_REFINE_PLATEAU=10
PD12ROUTE_PLATEAU_GAIN=1
PD12ROUTE_PLATEAU_MIN=1000
# Margin caps (Part 76).
PD13ROUTE_REGION_BOX_CAP=200
PD13ROUTE_REFINE_BOX_CAP=200
# Work-gated plateau stop (Part 80): 150 flat rounds costing >= 3.2e10
# search expansions (~5000 s on the M4 Pro).
PD14ROUTE_REGION_COST_WINDOW=150
PD14ROUTE_REGION_COST_POPS=32000000000
# Detour reclaim with a fallback (Parts 83-88): the standard path runs
# first; when it ends with 2D overflow <= 10, the reclaim path (mu 8 by
# default) is run from the same saved state and kept only if no worse on
# overflow and shorter. All 11 zero-overflow benchmarks got shorter (-0.16%
# to -4.1%, zeros kept); residue benchmarks are unchanged and pay nothing.
PD19ROUTE_RECLAIM_FALLBACK=1
PD21ROUTE_FALLBACK_A_MAX=10
