# lean24.env -- the lean ISPD 2024 pipeline, variant L (HISTORY_COST_SWEEP.md
# Part 115): layered on @standard.env @standard24.env, it skips every stage
# InstantGR (the open-source contest router) has no counterpart for. Kept:
# the batched pattern stage, layer assignment's first round, the 3D pattern
# passes. (lean24b.env is the variant that keeps the 2D stages.)
VROUTE_SLOW_ROUNDS=0
PD5ROUTE_REGION=0
PD4ROUTE_REFINE=0
PD19ROUTE_RECLAIM_FALLBACK=0
PD8ROUTE_REBUILD=0
PD7ROUTE_WL=0
NV2ROUTE_VIA_ROUNDS=0
